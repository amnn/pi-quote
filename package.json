{
  "name": "pi-quote",
  "version": "0.1.1",
  "description": "Quote previous messages in Pi's editor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amnn/pi-quote.git"
  },
  "homepage": "https://github.com/amnn/pi-quote#readme",
  "bugs": {
    "url": "https://github.com/amnn/pi-quote/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "quote",
    "reply"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.20.0",
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@types/node": "^22.20.1",
    "prettier": "3.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "smoke": "pi --offline --no-extensions -e . --list-models __pi_package_smoke__",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm test && pnpm run smoke && pnpm audit",
    "prepublishOnly": "pnpm check"
  }
}
