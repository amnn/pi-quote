{
  "name": "pi-quote",
  "version": "0.1.0",
  "description": "Quote previous messages in Pi's editor",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "quote",
    "reply"
  ],
  "license": "Apache-2.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "validate": "pnpm run check && pnpm test"
  }
}
